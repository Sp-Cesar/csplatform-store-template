# Copia este archivo como .env y completa los valores.
# En Vercel se cargan en Settings > Environment Variables.
# Las variables PUBLIC_* llegan al navegador; las demás quedan solo en el servidor.

# true = usa datos de ejemplo sin conectarse al backend (para diseñar).
# Con el slug "no-disponible" simula una web desactivada. Prohibido en producción (falla la compilación).
PUBLIC_MODO_DEMO=true

# slug asignado en el Centro de Control (3 a 40 caracteres: a-z, 0-9 y guiones).
PUBLIC_TIENDA_SLUG=demo

# Dominio del cliente, para SEO y sitemap.xml.
PUBLIC_SITIO_URL=http://localhost:4321

# --- Solo servidor: nunca llegan al navegador ---

# Backend CSPlatform (Supabase). La clave anon solo puede ejecutar las funciones web_*.
SUPABASE_URL=https://gmfjxazokphvccwcltkr.supabase.co
SUPABASE_ANON_KEY=

# Opcional: monitoreo de errores (DSN del proyecto en Sentry).
SENTRY_DSN=

# --- Opcional: analítica Umami (sin cookies) ---
# URL del script (Umami Cloud: https://cloud.umami.is/script.js) y el id del sitio.
PUBLIC_UMAMI_SCRIPT=
PUBLIC_UMAMI_ID=
