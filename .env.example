# Copia este archivo como .env y completa los valores.
# En Vercel se cargan en Settings > Environment Variables.

# true = usa datos de ejemplo sin conectarse al backend (para diseñar).
# Con el slug "no-disponible" simula una web desactivada.
PUBLIC_MODO_DEMO=true

# Backend CSPlatform (Supabase). La clave anon es pública por diseño:
# solo puede ejecutar las funciones web_* de lectura.
PUBLIC_SUPABASE_URL=https://gmfjxazokphvccwcltkr.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# slug asignado en el Centro de Control (3 a 40 caracteres: a-z, 0-9 y guiones).
PUBLIC_TIENDA_SLUG=demo

# Dominio del cliente, para SEO y sitemap.xml.
PUBLIC_SITIO_URL=http://localhost:4321
