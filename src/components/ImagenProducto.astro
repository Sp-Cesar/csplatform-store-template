---
// Imagen cuadrada del producto con marcador si no tiene foto. Diseño libre por cliente.
interface Props {
  src: string | null
  alt: string
  prioridad?: boolean
  tamano?: number
}

const { src, alt, prioridad = false, tamano = 400 } = Astro.props
---

<div class="aspect-square bg-stone-100">
  {
    src ? (
      <img
        src={src}
        alt={alt}
        width={tamano}
        height={tamano}
        loading={prioridad ? 'eager' : 'lazy'}
        fetchpriority={prioridad ? 'high' : 'auto'}
        decoding="async"
        class="h-full w-full object-contain"
      />
    ) : (
      <div class="flex h-full flex-col items-center justify-center gap-2 text-suave" role="img" aria-label={`${alt} (sin imagen)`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-10 w-10 opacity-40" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="9" cy="10" r="2" />
          <path d="m21 16-5-5-9 9" />
        </svg>
        <span class="text-xs">Sin imagen</span>
      </div>
    )
  }
</div>
