---
// Contenedor de las páginas legales: título, fecha y aviso de "texto base" mientras no esté revisado.
import { legal } from '../config/legal'
import { sitio } from '../lib/sitio'

interface Props {
  titulo: string
}

const { titulo } = Astro.props
const mostrarAviso = !legal.revisado && (import.meta.env.DEV || sitio.modoDemo)
---

<article class="mx-auto max-w-3xl">
  <h1 class="text-2xl font-semibold">{titulo}</h1>
  <p class="mt-1 text-sm text-suave">Última actualización: {new Date(`${legal.actualizado}T12:00:00`).toLocaleDateString('es-PE', { dateStyle: 'long' })}</p>
  {
    mostrarAviso && (
      <p role="note" class="mt-4 rounded-md border border-amber-300 bg-amber-50 p-3 text-sm">
        Texto base de la plantilla. Revísalo con asesoría legal, complétalo con los datos de la tienda y marca
        <code>revisado: true</code> en <code>src/config/legal.ts</code>. Este aviso solo se ve en desarrollo y modo demo.
      </p>
    )
  }
  <div class="legal mt-6 flex flex-col gap-4 leading-relaxed [&_h2]:mt-4 [&_h2]:text-lg [&_h2]:font-semibold [&_li]:ml-5 [&_li]:list-disc">
    <slot />
  </div>
</article>
