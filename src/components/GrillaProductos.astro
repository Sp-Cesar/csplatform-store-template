---
// Grilla de tarjetas. Diseño libre por cliente.
import TarjetaProducto from './TarjetaProducto.astro'
import type { ProductoResumen } from '../lib/tipos'

interface Props {
  productos: ProductoResumen[]
}

const { productos } = Astro.props
---

<ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
  {
    productos.map((producto, i) => (
      <li>
        <TarjetaProducto producto={producto} prioridad={i < 4} />
      </li>
    ))
  }
</ul>
